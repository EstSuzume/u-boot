CONFIG_DEFAULT_DEVICE_TREE="r7s9210-gr-mango"
CONFIG_RZA2=y
CONFIG_TARGET_GRMANGO=y
CONFIG_SYS_MONITOR_LEN=524288
CONFIG_SYS_LOAD_ADDR=0x80100000
CONFIG_SYS_CLK_FREQ=132000000
# CONFIG_EFI_LOADER is not set

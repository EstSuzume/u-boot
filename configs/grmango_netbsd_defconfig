CONFIG_BOOTDELAY=3
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTARGS="root=ld0a"
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="bootm ${kernel_flash} - ${fdt_flash}"
CONFIG_SYS_CBSIZE=256
CONFIG_SYS_PBSIZE=256

/* Environment of U-Boot for NetBSD / GR-MANGO */
/*
 * OctaFlash layout
 *   0x50000000  U-Boot
 *   0x500f0000  NetBSD device tree (r7s9210-gr-mango-netbsd.dtb)
 *   0x50100000  NetBSD kernel, a gzip-compressed uImage ("kernel" type)
 *               with its load address 0x60000040
 * bootm copies the device tree into RAM before it fills in the memory
 * banks and bootargs.
 */
kernel_flash=0x50100000
fdt_flash=0x500f0000
/*
 * Keep the device tree that bootm hands over at the top of the OctaRAM.
 * The NetBSD generic start code maps it 1:1 (VA = PA) before copying it;
 * at the top of the on-chip RAM (0x803xxxxx) that overlaps the kernel's
 * own mapping at KERNEL_BASE (0x80000000), as the kernel runs from the
 * OctaRAM.
 */
fdt_high=0x60800000

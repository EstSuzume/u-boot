/* Environment of U-Boot for NetBSD / GR-PEACH */
/*
 * Serial flash layout:
 *   0x18000000  U-Boot
 *   0x180f0000  NetBSD device tree (r7s72100-gr-peach-netbsd.dtb)
 *   0x18100000  NetBSD kernel, a gzip-compressed uImage ("kernel" type)
 *               with its load address 0x20100040
 * bootm copies the device tree into RAM before it fills in the memory
 * node and bootargs. The kernel runs from the second MiB of the on-chip
 * RAM: the NetBSD kernel requires a 1MiB aligned load address, and the
 * first MiB holds the data-retention RAM (0x20000000-0x2001ffff), whose
 * write enable the kernel sets and so must not run in.
 */
kernel_flash=0x18100000
fdt_flash=0x180f0000
